{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/v-2/assets/(.*)",
      "dest": "/v-2/assets/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/v-1/assets/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}